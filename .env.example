VITE_DEMO_MODE=true
VITE_TELEMETRY_API_URL=http://127.0.0.1:7071
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

TRANSLINK_API_KEY=
TRANSLINK_GTFS_TRIPS_URL=https://gtfsapi.translink.ca/v3/gtfsrealtime
TRANSLINK_GTFS_POSITIONS_URL=https://gtfsapi.translink.ca/v3/gtfsposition
TRANSLINK_GTFS_ALERTS_URL=https://gtfsapi.translink.ca/v3/gtfsalerts
TRANSLINK_GTFS_STATIC_DIR=data/gtfs-static
TRANSLINK_POLL_INTERVAL_MS=15000
PORT=7071
PUBLISHER_ALLOWED_ORIGIN=http://localhost:5173
PUBLISHER_LOG_EVENTS=false

# Requests allowed per caller each minute. Zero disables the limit.
PUBLISHER_RATE_LIMIT_PER_MINUTE=60

# Include dependency error text in /api/health. Leave false on public ingress.
PUBLISHER_EXPOSE_ERROR_DETAIL=false

# Paste values from the Fabric Eventstream Custom Endpoint connection details.
FABRIC_EVENTSTREAM_BROKERS=
FABRIC_EVENTSTREAM_TOPIC=
FABRIC_EVENTSTREAM_USERNAME=
FABRIC_EVENTSTREAM_PASSWORD=

# Eventhouse query endpoint that serves /api/live and /api/route-performance.
# Copy queryServiceUri from .fabric/deployment.local.json.
FABRIC_KQL_QUERY_URI=
FABRIC_KQL_DATABASE=TransLinkOperations